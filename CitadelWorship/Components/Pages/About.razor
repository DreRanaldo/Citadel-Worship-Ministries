@page "/about"

<PageTitle>About Us - Citadel Worship Ministries</PageTitle>

<!-- Page Header -->
<section class="page-header bg-dark text-white py-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">About Us</h1>
        <p class="lead">Learn about our history, leadership, and what we believe</p>
    </div>
</section>

<!-- Church History -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4">Our Story</h2>
                <p class="fs-5">
                    Citadel Worship Ministries was founded with a vision to create a community of believers who worship God
                    in spirit and truth, serve one another with love, and reach the world with the Gospel of Jesus Christ.
                </p>
                <p>
                    From humble beginnings as a small prayer group, God has faithfully grown this ministry into a vibrant
                    church family. We are committed to sound biblical teaching, passionate worship, and authentic community.
                </p>
                <p>
                    Our name "Citadel" represents a place of refuge and strength — and that is exactly what we aim to be
                    for every person who walks through our doors. Whether you are a seasoned believer or just beginning
                    your spiritual journey, there is a place for you here.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="bg-light p-5 rounded text-center">
                    <i class="bi bi-building fs-1 text-primary"></i>
                    <h4 class="mt-3">A Place of Refuge & Strength</h4>
                    <p class="fst-italic">"God is our refuge and strength, an ever-present help in trouble." — Psalm 46:1</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Beliefs -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Our Mission & Beliefs</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-bullseye fs-1 text-primary"></i>
                        <h4 class="mt-3">Our Mission</h4>
                        <p>To make disciples of Jesus Christ through worship, teaching, fellowship, and outreach — building a community that reflects the love and character of God.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-eye fs-1 text-primary"></i>
                        <h4 class="mt-3">Our Vision</h4>
                        <p>To see lives transformed by the power of God's Word and Spirit, raising up a generation of passionate worshippers and world-changers.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-heart fs-1 text-primary"></i>
                        <h4 class="mt-3">Our Values</h4>
                        <p>Biblical Authority, Authentic Worship, Loving Community, Sacrificial Service, and Intentional Discipleship.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- What We Believe -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5">What We Believe</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">1</span>
                    </div>
                    <div>
                        <h5>The Bible</h5>
                        <p>We believe the Bible is the inspired, infallible, and authoritative Word of God — our guide for faith and practice.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">2</span>
                    </div>
                    <div>
                        <h5>The Trinity</h5>
                        <p>We believe in one God, eternally existing in three persons — Father, Son, and Holy Spirit.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">3</span>
                    </div>
                    <div>
                        <h5>Salvation</h5>
                        <p>We believe salvation is a gift from God, received through faith in Jesus Christ, who died for our sins and rose again.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">4</span>
                    </div>
                    <div>
                        <h5>The Holy Spirit</h5>
                        <p>We believe in the present ministry of the Holy Spirit who empowers believers to live godly lives and serve effectively.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">5</span>
                    </div>
                    <div>
                        <h5>The Church</h5>
                        <p>We believe the church is the body of Christ, called to worship, fellowship, discipleship, and mission in the world.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">6</span>
                    </div>
                    <div>
                        <h5>The Return of Christ</h5>
                        <p>We believe in the personal, visible return of Jesus Christ and the promise of eternal life for all who trust in Him.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Leadership -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Our Leadership</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <div class="leader-avatar mb-3">
                            <i class="bi bi-person-circle display-1 text-secondary"></i>
                        </div>
                        <h4>Pastor David Thompson</h4>
                        <p class="text-primary fw-semibold">Senior Pastor</p>
                        <p class="text-muted">Pastor David has been leading Citadel Worship Ministries with a heart for worship and a passion for teaching the Word of God.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <div class="leader-avatar mb-3">
                            <i class="bi bi-person-circle display-1 text-secondary"></i>
                        </div>
                        <h4>Minister Sarah Johnson</h4>
                        <p class="text-primary fw-semibold">Worship Director</p>
                        <p class="text-muted">Minister Sarah leads our worship ministry with excellence and a deep devotion to creating an atmosphere of praise.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <div class="leader-avatar mb-3">
                            <i class="bi bi-person-circle display-1 text-secondary"></i>
                        </div>
                        <h4>Elder James Wright</h4>
                        <p class="text-primary fw-semibold">Church Elder</p>
                        <p class="text-muted">Elder Wright provides spiritual oversight and guidance to the church body with wisdom and compassion.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
