@page "/events"
@inject IEventService EventService

<PageTitle>Events - Citadel Worship Ministries</PageTitle>

<section class="page-header bg-dark text-white py-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Events</h1>
        <p class="lead">Stay connected with what's happening at Citadel Worship</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (_events == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!_events.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x fs-1 text-muted"></i>
                <p class="text-muted mt-3">No upcoming events at this time. Check back soon!</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var evt in _events)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex align-items-start mb-3">
                                    <div class="event-date-badge text-center me-3 flex-shrink-0">
                                        <div class="event-month">@evt.StartDate.ToString("MMM").ToUpper()</div>
                                        <div class="event-day">@evt.StartDate.Day</div>
                                    </div>
                                    <div>
                                        <h5 class="card-title mb-1">@evt.Title</h5>
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-clock"></i> @evt.StartDate.ToString("h:mm tt")
                                            @if (evt.EndDate.HasValue)
                                            {
                                                <text> - @evt.EndDate.Value.ToString("h:mm tt")</text>
                                            }
                                        </p>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(evt.Location))
                                {
                                    <p class="text-muted mb-2">
                                        <i class="bi bi-geo-alt"></i> @evt.Location
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(evt.Description))
                                {
                                    <p class="card-text">@TruncateText(evt.Description, 120)</p>
                                }
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (!string.IsNullOrEmpty(evt.Category))
                                    {
                                        <span class="badge bg-secondary">@evt.Category</span>
                                    }
                                    @if (evt.IsMembersOnly)
                                    {
                                        <span class="badge bg-info">Members Only</span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pb-3">
                                <a href="/events/@evt.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<Event>? _events;

    protected override async Task OnInitializedAsync()
    {
        _events = await EventService.GetUpcomingAsync();
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        return text.Length <= maxLength ? text : text[..maxLength] + "...";
    }
}
