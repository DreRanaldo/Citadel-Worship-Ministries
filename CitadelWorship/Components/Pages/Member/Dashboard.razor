@page "/member/dashboard"
@attribute [Authorize(Roles = "Member,Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IAnnouncementService AnnouncementService
@inject IEventService EventService
@inject IPrayerRequestService PrayerRequestService
@using Microsoft.AspNetCore.Identity

<PageTitle>Member Dashboard - Citadel Worship Ministries</PageTitle>

<section class="page-header bg-dark text-white py-4">
    <div class="container">
        <h1><i class="bi bi-speedometer2"></i> Member Dashboard</h1>
        @if (_user != null)
        {
            <p class="mb-0">Welcome back, @_user.FirstName!</p>
        }
    </div>
</section>

<section class="py-4">
    <div class="container">
        <!-- Quick Links -->
        <div class="row g-4 mb-5">
            <div class="col-md-3 col-sm-6">
                <a href="/member/announcements" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center h-100 dashboard-card">
                        <div class="card-body">
                            <i class="bi bi-megaphone fs-1 text-primary"></i>
                            <h5 class="mt-2 text-dark">Announcements</h5>
                            <span class="badge bg-primary rounded-pill">@(_announcements?.Count ?? 0)</span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="/member/events" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center h-100 dashboard-card">
                        <div class="card-body">
                            <i class="bi bi-calendar-event fs-1 text-success"></i>
                            <h5 class="mt-2 text-dark">Events</h5>
                            <span class="badge bg-success rounded-pill">@(_events?.Count ?? 0)</span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="/member/prayer-requests" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center h-100 dashboard-card">
                        <div class="card-body">
                            <i class="bi bi-chat-heart fs-1 text-danger"></i>
                            <h5 class="mt-2 text-dark">Prayer Requests</h5>
                            <span class="badge bg-danger rounded-pill">@(_prayerRequests?.Count ?? 0)</span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="/account/profile" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center h-100 dashboard-card">
                        <div class="card-body">
                            <i class="bi bi-person-gear fs-1 text-warning"></i>
                            <h5 class="mt-2 text-dark">My Profile</h5>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <div class="row g-4">
            <!-- Recent Announcements -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-megaphone"></i> Latest Announcements</h5>
                    </div>
                    <div class="card-body">
                        @if (_announcements?.Any() == true)
                        {
                            @foreach (var announcement in _announcements.Take(5))
                            {
                                <div class="border-bottom pb-3 mb-3">
                                    <h6>@announcement.Title</h6>
                                    <p class="text-muted small mb-1">@announcement.PublishDate.ToString("MMM d, yyyy")</p>
                                    <p class="mb-0">@TruncateText(announcement.Content, 100)</p>
                                    @if (announcement.IsMembersOnly)
                                    {
                                        <span class="badge bg-info">Members Only</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No announcements at this time.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Upcoming Events -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Upcoming Events</h5>
                    </div>
                    <div class="card-body">
                        @if (_events?.Any() == true)
                        {
                            @foreach (var evt in _events.Take(5))
                            {
                                <div class="d-flex border-bottom pb-3 mb-3">
                                    <div class="event-date-badge text-center me-3 flex-shrink-0">
                                        <div class="event-month">@evt.StartDate.ToString("MMM").ToUpper()</div>
                                        <div class="event-day">@evt.StartDate.Day</div>
                                    </div>
                                    <div>
                                        <h6 class="mb-1">@evt.Title</h6>
                                        <p class="text-muted small mb-0">
                                            @evt.StartDate.ToString("h:mm tt") @(!string.IsNullOrEmpty(evt.Location) ? $"| {evt.Location}" : "")
                                        </p>
                                        @if (evt.IsMembersOnly)
                                        {
                                            <span class="badge bg-info">Members Only</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No upcoming events.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private ApplicationUser? _user;
    private List<Announcement>? _announcements;
    private List<Event>? _events;
    private List<PrayerRequest>? _prayerRequests;

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User != null)
        {
            _user = await UserManager.GetUserAsync(httpContext.User);
            if (_user != null)
            {
                _prayerRequests = await PrayerRequestService.GetByUserAsync(_user.Id);
            }
        }

        _announcements = await AnnouncementService.GetActiveAsync(includeMembersOnly: true);
        _events = await EventService.GetUpcomingAsync(includeMembersOnly: true);
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        return text.Length <= maxLength ? text : text[..maxLength] + "...";
    }
}
