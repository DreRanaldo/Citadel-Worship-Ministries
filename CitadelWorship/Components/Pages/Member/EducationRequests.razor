@page "/member/education-requests"
@attribute [Authorize(Roles = "Member,AdminAssistant,Admin")]
@inject IEducationRequestService EducationRequestService
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Identity

<PageTitle>Education Assistance - Citadel Worship Ministries</PageTitle>

<section class="page-header bg-dark text-white py-4">
    <div class="container">
        <h1><i class="bi bi-mortarboard"></i> Education Assistance</h1>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Submit Form -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="mb-4">Submit a Request</h4>

                        @if (_submitted)
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-check-circle"></i> Your request has been submitted. We will review it shortly.
                            </div>
                            <button class="btn btn-outline-primary" @onclick="ResetForm">Submit Another</button>
                        }
                        else
                        {
                            <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="EducationRequestForm">
                                <DataAnnotationsValidator />

                                <div class="mb-3">
                                    <label class="form-label">Title <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="_model.Title" placeholder="Brief title for your request" />
                                    <ValidationMessage For="() => _model.Title" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Request Type <span class="text-danger">*</span></label>
                                    <InputSelect class="form-select" @bind-Value="_model.RequestType">
                                        <option value="@EducationRequestType.HomeworkHelp">Homework Help</option>
                                        <option value="@EducationRequestType.PrintingAssistance">Printing Assistance</option>
                                        <option value="@EducationRequestType.EducationalSupport">Educational Support</option>
                                        <option value="@EducationRequestType.Other">Other</option>
                                    </InputSelect>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description <span class="text-danger">*</span></label>
                                    <InputTextArea class="form-control" @bind-Value="_model.Description" rows="5" placeholder="Describe what you need help with..." />
                                    <ValidationMessage For="() => _model.Description" class="text-danger" />
                                </div>

                                <button type="submit" class="btn btn-primary" disabled="@_submitting">
                                    @if (_submitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="bi bi-send"></i> Submit Request
                                </button>
                            </EditForm>
                        }
                    </div>
                </div>
            </div>

            <!-- My Requests -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">My Requests</h5>
                    </div>
                    <div class="card-body">
                        @if (_myRequests == null)
                        {
                            <div class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                            </div>
                        }
                        else if (!_myRequests.Any())
                        {
                            <p class="text-muted text-center py-3">No education requests yet.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var req in _myRequests)
                                {
                                    <div class="list-group-item px-0">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="mb-1">@req.Title</h6>
                                                <p class="text-muted small mb-1">@req.RequestType — @req.SubmittedAt.ToString("MMM d, yyyy")</p>
                                                <p class="mb-0">@req.Description</p>
                                                @if (!string.IsNullOrEmpty(req.ResolutionNotes))
                                                {
                                                    <p class="text-success small mt-1"><i class="bi bi-check-circle"></i> @req.ResolutionNotes</p>
                                                }
                                            </div>
                                            <span class="badge @GetStatusBadge(req.Status)">@req.Status</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <a href="/member/dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
        </div>
    </div>
</section>

@code {
    private EducationRequest _model = new();
    private List<EducationRequest>? _myRequests;
    private bool _submitted;
    private bool _submitting;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User != null)
        {
            var user = await UserManager.GetUserAsync(httpContext.User);
            if (user != null)
            {
                _userId = user.Id;
                _myRequests = await EducationRequestService.GetByUserAsync(user.Id);
            }
        }
    }

    private async Task HandleSubmit()
    {
        _submitting = true;
        try
        {
            _model.SubmittedByUserId = _userId;
            await EducationRequestService.CreateAsync(_model);
            _submitted = true;
            if (_userId != null)
                _myRequests = await EducationRequestService.GetByUserAsync(_userId);
        }
        finally { _submitting = false; }
    }

    private void ResetForm() { _model = new(); _submitted = false; }

    private string GetStatusBadge(RequestStatus s) => s switch
    {
        RequestStatus.Submitted => "bg-primary",
        RequestStatus.InReview => "bg-warning text-dark",
        RequestStatus.Assigned => "bg-info",
        RequestStatus.Completed => "bg-success",
        RequestStatus.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
}
