@page "/ministries"
@inject IMinistryService MinistryService

<PageTitle>Ministries - Citadel Worship Ministries</PageTitle>

<section class="page-header bg-dark text-white py-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Our Ministries</h1>
        <p class="lead">Find your place to serve and grow in faith</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (_ministries == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!_ministries.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-muted"></i>
                <p class="text-muted mt-3">No ministries listed at this time.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ministry in _ministries)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm ministry-card">
                            <div class="card-body">
                                <div class="text-center mb-3">
                                    <i class="bi bi-people-fill fs-1 text-primary"></i>
                                </div>
                                <h4 class="card-title text-center">@ministry.Name</h4>
                                @if (!string.IsNullOrEmpty(ministry.LeaderName))
                                {
                                    <p class="text-center text-muted mb-3">
                                        <i class="bi bi-person"></i> @ministry.LeaderName
                                    </p>
                                }
                                <p class="card-text">@TruncateText(ministry.Description, 150)</p>
                                @if (!string.IsNullOrEmpty(ministry.MeetingSchedule))
                                {
                                    <p class="text-muted small mb-1">
                                        <i class="bi bi-clock"></i> @ministry.MeetingSchedule
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(ministry.MeetingLocation))
                                {
                                    <p class="text-muted small">
                                        <i class="bi bi-geo-alt"></i> @ministry.MeetingLocation
                                    </p>
                                }
                            </div>
                            <div class="card-footer bg-transparent border-0 text-center pb-3">
                                <a href="/ministries/@ministry.Id" class="btn btn-outline-primary">Learn More</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<Ministry>? _ministries;

    protected override async Task OnInitializedAsync()
    {
        _ministries = await MinistryService.GetActiveAsync();
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        return text.Length <= maxLength ? text : text[..maxLength] + "...";
    }
}
