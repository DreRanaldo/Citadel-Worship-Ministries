@page "/assistant/finances"
@layout AssistantLayout
@attribute [Authorize(Roles = "AdminAssistant,Admin")]
@inject IFinancialService FinancialService

<PageTitle>Finances - Citadel Worship Ministries</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-cash-coin"></i> Financial Records</h2>
        <div>
            <a href="/assistant/dashboard" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
            <a href="/assistant/finances/log" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Log Financial Record
            </a>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading financial data...</p>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        @if (_summary != null)
        {
            <div class="row g-4 mb-4">
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm border-start border-primary border-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1 small text-uppercase">Total Tithes</p>
                                    <h4 class="fw-bold mb-0 text-primary">@_summary.TotalTithes.ToString("C")</h4>
                                </div>
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                    <i class="bi bi-bookmark-fill text-primary fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm border-start border-success border-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1 small text-uppercase">Total Offerings</p>
                                    <h4 class="fw-bold mb-0 text-success">@_summary.TotalOfferings.ToString("C")</h4>
                                </div>
                                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                    <i class="bi bi-heart-fill text-success fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm border-start border-warning border-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1 small text-uppercase">Total Special Seeds</p>
                                    <h4 class="fw-bold mb-0 text-warning">@_summary.TotalSpecialSeeds.ToString("C")</h4>
                                </div>
                                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                                    <i class="bi bi-star-fill text-warning fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm border-start border-dark border-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1 small text-uppercase">Grand Total</p>
                                    <h4 class="fw-bold mb-0">@_summary.GrandTotal.ToString("C")</h4>
                                </div>
                                <div class="rounded-circle bg-dark bg-opacity-10 p-3">
                                    <i class="bi bi-cash-stack text-dark fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Date Range Filter -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="row align-items-center g-2">
                    <div class="col-auto">
                        <label class="form-label mb-0 fw-semibold"><i class="bi bi-funnel"></i> Filter:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="date" class="form-control form-control-sm" @bind="_filterStart" placeholder="Start date" />
                    </div>
                    <div class="col-auto">
                        <span class="text-muted">to</span>
                    </div>
                    <div class="col-md-3">
                        <input type="date" class="form-control form-control-sm" @bind="_filterEnd" placeholder="End date" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary" @onclick="ApplyFilter">
                            <i class="bi bi-search"></i> Apply
                        </button>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilter">
                            <i class="bi bi-x-circle"></i> Clear
                        </button>
                    </div>
                    <div class="col text-end">
                        <span class="text-muted small">@(_records?.Count ?? 0) record(s)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Records Table -->
        <div class="card border-0 shadow-sm">
            @if (_records?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Member</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                                <th>Service/Event</th>
                                <th>Reference #</th>
                                <th>Submitted By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in _records)
                            {
                                <tr>
                                    <td>@record.DateRecorded.ToString("MMM d, yyyy")</td>
                                    <td>
                                        <span class="badge @GetTypeBadge(record.RecordType)">@GetTypeLabel(record.RecordType)</span>
                                    </td>
                                    <td>@(record.Member?.FullName ?? record.MemberName ?? "Anonymous")</td>
                                    <td class="fw-bold">@record.Amount.ToString("C")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi @GetPaymentIcon(record.PaymentMethod) me-1"></i>@record.PaymentMethod
                                        </span>
                                    </td>
                                    <td>@(record.ServiceOrEvent ?? "-")</td>
                                    <td><code>@(record.ReferenceNumber ?? "-")</code></td>
                                    <td>@(record.SubmittedByUser?.FullName ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-cash fs-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No financial records found</h5>
                    <p class="text-muted">Start by logging a new financial record.</p>
                    <a href="/assistant/finances/log" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Log Financial Record
                    </a>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private List<FinancialRecord>? _records;
    private FinancialSummary? _summary;
    private DateTime? _filterStart;
    private DateTime? _filterEnd;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _records = await FinancialService.GetAllAsync();
            _summary = await FinancialService.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading finances: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilter()
    {
        _isLoading = true;
        try
        {
            if (_filterStart.HasValue && _filterEnd.HasValue)
            {
                _records = await FinancialService.GetByDateRangeAsync(_filterStart.Value, _filterEnd.Value);
                _summary = await FinancialService.GetSummaryAsync(_filterStart.Value, _filterEnd.Value);
            }
            else
            {
                _records = await FinancialService.GetAllAsync();
                _summary = await FinancialService.GetSummaryAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ClearFilter()
    {
        _filterStart = null;
        _filterEnd = null;
        await ApplyFilter();
    }

    private string GetTypeBadge(FinancialRecordType type) => type switch
    {
        FinancialRecordType.Tithe => "bg-primary",
        FinancialRecordType.Offering => "bg-success",
        FinancialRecordType.SpecialSeed => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string GetTypeLabel(FinancialRecordType type) => type switch
    {
        FinancialRecordType.Tithe => "Tithe",
        FinancialRecordType.Offering => "Offering",
        FinancialRecordType.SpecialSeed => "Special Seed",
        _ => type.ToString()
    };

    private string GetPaymentIcon(PaymentMethod method) => method switch
    {
        PaymentMethod.Cash => "bi-cash",
        PaymentMethod.Transfer => "bi-arrow-left-right",
        PaymentMethod.Cheque => "bi-file-earmark-text",
        PaymentMethod.Online => "bi-globe",
        PaymentMethod.Other => "bi-three-dots",
        _ => "bi-credit-card"
    };
}
