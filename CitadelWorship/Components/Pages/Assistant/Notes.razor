@page "/assistant/notes"
@layout AssistantLayout
@attribute [Authorize(Roles = "AdminAssistant,Admin")]
@using Microsoft.AspNetCore.Identity
@inject ISpecialNoteService SpecialNoteService
@inject IAuditService AuditService
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Special Notes - Citadel Worship Ministries</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-journal-text"></i> Special Notes</h2>
        <div>
            <a href="/assistant/dashboard" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
            <button class="btn btn-primary" @onclick="ToggleAddForm">
                <i class="bi @(_showAddForm ? "bi-x-circle" : "bi-plus-circle")"></i>
                @(_showAddForm ? "Cancel" : "Add Note")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <!-- Add Note Form -->
    @if (_showAddForm)
    {
        <div class="card border-0 shadow-sm mb-4 border-top border-primary border-3">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-pencil-fill text-primary"></i> Create New Note</h5>
            </div>
            <div class="card-body p-4">
                <EditForm Model="_newNote" OnValidSubmit="HandleCreateNote" FormName="createNoteForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row g-3">
                        <!-- Subject -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_newNote.Subject" placeholder="Enter note subject" />
                            <ValidationMessage For="() => _newNote.Subject" class="text-danger" />
                        </div>

                        <!-- Category -->
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Category</label>
                            <InputSelect class="form-select" @bind-Value="_newNote.Category">
                                <option value="@NoteCategory.General">General</option>
                                <option value="@NoteCategory.FirstTimeVisitor">First Time Visitor</option>
                                <option value="@NoteCategory.CounselingReferral">Counseling Referral</option>
                                <option value="@NoteCategory.FollowUpRequired">Follow Up Required</option>
                                <option value="@NoteCategory.Confidential">Confidential</option>
                            </InputSelect>
                        </div>

                        <!-- Is Confidential -->
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <InputCheckbox class="form-check-input" @bind-Value="_newNote.IsConfidential" />
                                <label class="form-check-label fw-semibold">
                                    <i class="bi bi-lock-fill text-danger"></i> Confidential
                                </label>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Content <span class="text-danger">*</span></label>
                            <InputTextArea class="form-control" @bind-Value="_newNote.Content" rows="4" placeholder="Enter note details..." />
                            <ValidationMessage For="() => _newNote.Content" class="text-danger" />
                        </div>

                        <!-- Related Member Name -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Related Member Name</label>
                            <InputText class="form-control" @bind-Value="_newNote.RelatedMemberName" placeholder="Name of related member (optional)" />
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleAddForm">
                            <i class="bi bi-x-circle"></i> Cancel
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle"></i>
                                <span> Create Note</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Notes List -->
    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading notes...</p>
        </div>
    }
    else if (_notes == null || !_notes.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-journal fs-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No notes found</h5>
                <p class="text-muted">Create your first note to get started.</p>
                <button class="btn btn-primary" @onclick="ToggleAddForm">
                    <i class="bi bi-plus-circle"></i> Add Note
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Category Filter -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <span class="fw-semibold me-2"><i class="bi bi-funnel"></i> Filter:</span>
                    <button class="btn btn-sm @(_categoryFilter == null ? "btn-dark" : "btn-outline-dark")"
                            @onclick="() => _categoryFilter = null">
                        All (@_notes.Count)
                    </button>
                    @foreach (NoteCategory category in Enum.GetValues(typeof(NoteCategory)))
                    {
                        var count = _notes.Count(n => n.Category == category);
                        if (count > 0)
                        {
                            <button class="btn btn-sm @(_categoryFilter == category ? GetCategoryButtonActive(category) : GetCategoryButtonOutline(category))"
                                    @onclick="() => _categoryFilter = category">
                                @GetCategoryLabel(category) (@count)
                            </button>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Related Member</th>
                            <th>Created Date</th>
                            <th>Confidential</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in FilteredNotes)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @if (note.IsConfidential)
                                    {
                                        <i class="bi bi-lock-fill text-danger me-1"></i>
                                    }
                                    @note.Subject
                                </td>
                                <td>
                                    <span class="badge @GetCategoryBadge(note.Category)">@GetCategoryLabel(note.Category)</span>
                                </td>
                                <td>@(note.RelatedMember?.FullName ?? note.RelatedMemberName ?? "-")</td>
                                <td>@note.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td>
                                    @if (note.IsConfidential)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-lock-fill"></i> Confidential</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Public</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _showAddForm = false;
    private List<SpecialNote>? _notes;
    private SpecialNote _newNote = new();
    private NoteCategory? _categoryFilter;
    private string? _successMessage;
    private string? _errorMessage;

    private IEnumerable<SpecialNote> FilteredNotes =>
        (_notes ?? new List<SpecialNote>())
            .Where(n => _categoryFilter == null || n.Category == _categoryFilter);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _notes = await SpecialNoteService.GetAllAsync(includeConfidential: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading notes: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleAddForm()
    {
        _showAddForm = !_showAddForm;
        if (_showAddForm)
        {
            _newNote = new SpecialNote();
        }
    }

    private async Task HandleCreateNote()
    {
        _isSaving = true;
        _errorMessage = null;

        try
        {
            var currentUser = await GetCurrentUserAsync();
            _newNote.CreatedByUserId = currentUser?.Id;

            await SpecialNoteService.CreateAsync(_newNote);

            // Audit log
            await AuditService.LogAsync(
                "Create",
                "SpecialNote",
                _newNote.Id.ToString(),
                $"Created note: {_newNote.Subject} ({_newNote.Category})",
                currentUser?.Id,
                currentUser?.FullName
            );

            _successMessage = $"Note \"{_newNote.Subject}\" created successfully.";
            _showAddForm = false;
            _newNote = new SpecialNote();

            // Refresh
            _notes = await SpecialNoteService.GetAllAsync(includeConfidential: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error creating note: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task<ApplicationUser?> GetCurrentUserAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User?.Identity?.IsAuthenticated == true)
        {
            return await UserManager.GetUserAsync(httpContext.User);
        }
        return null;
    }

    private string GetCategoryBadge(NoteCategory category) => category switch
    {
        NoteCategory.FirstTimeVisitor => "bg-info",
        NoteCategory.CounselingReferral => "bg-warning text-dark",
        NoteCategory.FollowUpRequired => "bg-danger",
        NoteCategory.General => "bg-secondary",
        NoteCategory.Confidential => "bg-dark",
        _ => "bg-secondary"
    };

    private string GetCategoryLabel(NoteCategory category) => category switch
    {
        NoteCategory.FirstTimeVisitor => "First Time Visitor",
        NoteCategory.CounselingReferral => "Counseling Referral",
        NoteCategory.FollowUpRequired => "Follow Up Required",
        NoteCategory.General => "General",
        NoteCategory.Confidential => "Confidential",
        _ => category.ToString()
    };

    private string GetCategoryButtonActive(NoteCategory category) => category switch
    {
        NoteCategory.FirstTimeVisitor => "btn-info",
        NoteCategory.CounselingReferral => "btn-warning",
        NoteCategory.FollowUpRequired => "btn-danger",
        NoteCategory.General => "btn-secondary",
        NoteCategory.Confidential => "btn-dark",
        _ => "btn-secondary"
    };

    private string GetCategoryButtonOutline(NoteCategory category) => category switch
    {
        NoteCategory.FirstTimeVisitor => "btn-outline-info",
        NoteCategory.CounselingReferral => "btn-outline-warning",
        NoteCategory.FollowUpRequired => "btn-outline-danger",
        NoteCategory.General => "btn-outline-secondary",
        NoteCategory.Confidential => "btn-outline-dark",
        _ => "btn-outline-secondary"
    };
}
