@page "/assistant/education-requests"
@layout AssistantLayout
@attribute [Authorize(Roles = "AdminAssistant,Admin")]
@inject IEducationRequestService EducationRequestService

<PageTitle>Education Requests - Citadel Worship Ministries</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-mortarboard-fill"></i> Education Requests</h2>
        <a href="/assistant/dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading education requests...</p>
        </div>
    }
    else if (_requests == null || !_requests.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-mortarboard fs-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No education requests found</h5>
                <p class="text-muted">Education requests submitted by members will appear here.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Status Filter -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm @(_statusFilter == null ? "btn-dark" : "btn-outline-dark")" @onclick="() => FilterByStatus(null)">
                        All (@_requests.Count)
                    </button>
                    @foreach (RequestStatus status in Enum.GetValues(typeof(RequestStatus)))
                    {
                        var count = _requests.Count(r => r.Status == status);
                        <button class="btn btn-sm @(_statusFilter == status ? GetStatusButtonActive(status) : GetStatusButtonOutline(status))"
                                @onclick="() => FilterByStatus(status)">
                            @status (@count)
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Requests Table -->
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th></th>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Submitted By</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in FilteredRequests)
                        {
                            <tr>
                                <td>
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleExpand(request.Id)">
                                        <i class="bi @(_expandedId == request.Id ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                    </button>
                                </td>
                                <td class="fw-semibold">@request.Title</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@GetRequestTypeLabel(request.RequestType)</span>
                                </td>
                                <td>@(request.SubmittedByUser?.FullName ?? "Unknown")</td>
                                <td>@request.SubmittedAt.ToString("MMM d, yyyy")</td>
                                <td>
                                    <span class="badge @GetStatusBadge(request.Status)">@request.Status</span>
                                </td>
                                <td>@(request.AssignedTo ?? "-")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" @onclick="() => OpenUpdatePanel(request)"
                                                title="Update Status">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @if (_expandedId == request.Id)
                            {
                                <tr>
                                    <td colspan="8">
                                        <div class="bg-light rounded p-3 mx-3">
                                            <div class="row">
                                                <div class="col-md-8">
                                                    <h6 class="fw-bold">Description</h6>
                                                    <p class="mb-2">@request.Description</p>

                                                    @if (!string.IsNullOrEmpty(request.InternalNotes))
                                                    {
                                                        <h6 class="fw-bold mt-3">Internal Notes</h6>
                                                        <p class="mb-2 text-muted">@request.InternalNotes</p>
                                                    }

                                                    @if (!string.IsNullOrEmpty(request.ResolutionNotes))
                                                    {
                                                        <h6 class="fw-bold mt-3">Resolution Notes</h6>
                                                        <p class="mb-0 text-success">@request.ResolutionNotes</p>
                                                    }
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="small text-muted">
                                                        <p class="mb-1"><strong>Submitted:</strong> @request.SubmittedAt.ToString("MMM d, yyyy h:mm tt")</p>
                                                        @if (request.UpdatedAt.HasValue)
                                                        {
                                                            <p class="mb-1"><strong>Updated:</strong> @request.UpdatedAt.Value.ToString("MMM d, yyyy h:mm tt")</p>
                                                        }
                                                        @if (request.CompletedAt.HasValue)
                                                        {
                                                            <p class="mb-1"><strong>Completed:</strong> @request.CompletedAt.Value.ToString("MMM d, yyyy h:mm tt")</p>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Update Panel Modal -->
        @if (_editingRequest != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Update Request</h5>
                            <button type="button" class="btn-close" @onclick="CloseUpdatePanel"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Title</label>
                                <p class="form-control-plaintext fw-bold">@_editingRequest.Title</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Status</label>
                                <select class="form-select" @bind="_editStatus">
                                    @foreach (RequestStatus status in Enum.GetValues(typeof(RequestStatus)))
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Assigned To</label>
                                <input type="text" class="form-control" @bind="_editAssignedTo" placeholder="Name of assigned person" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Internal Notes</label>
                                <textarea class="form-control" @bind="_editNotes" rows="3" placeholder="Add internal notes..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" @onclick="CloseUpdatePanel">Cancel</button>
                            <button class="btn btn-primary" @onclick="SaveUpdate" disabled="@_isUpdating">
                                @if (_isUpdating)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle"></i>
                                    <span> Save Changes</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isUpdating = false;
    private List<EducationRequest>? _requests;
    private RequestStatus? _statusFilter;
    private int? _expandedId;
    private string? _successMessage;
    private string? _errorMessage;

    // Edit panel state
    private EducationRequest? _editingRequest;
    private RequestStatus _editStatus;
    private string? _editAssignedTo;
    private string? _editNotes;

    private IEnumerable<EducationRequest> FilteredRequests =>
        (_requests ?? new List<EducationRequest>())
            .Where(r => _statusFilter == null || r.Status == _statusFilter);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _requests = await EducationRequestService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading requests: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterByStatus(RequestStatus? status)
    {
        _statusFilter = status;
    }

    private void ToggleExpand(int id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private void OpenUpdatePanel(EducationRequest request)
    {
        _editingRequest = request;
        _editStatus = request.Status;
        _editAssignedTo = request.AssignedTo;
        _editNotes = request.InternalNotes;
    }

    private void CloseUpdatePanel()
    {
        _editingRequest = null;
    }

    private async Task SaveUpdate()
    {
        if (_editingRequest == null) return;

        _isUpdating = true;
        try
        {
            _editingRequest.Status = _editStatus;
            _editingRequest.AssignedTo = _editAssignedTo;
            _editingRequest.InternalNotes = _editNotes;

            if (_editStatus == RequestStatus.Completed && !_editingRequest.CompletedAt.HasValue)
            {
                _editingRequest.CompletedAt = DateTime.UtcNow;
            }

            await EducationRequestService.UpdateAsync(_editingRequest);

            _successMessage = $"Request \"{_editingRequest.Title}\" updated successfully.";
            _editingRequest = null;

            // Refresh
            _requests = await EducationRequestService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error updating request: {ex.Message}";
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private string GetStatusBadge(RequestStatus status) => status switch
    {
        RequestStatus.Submitted => "bg-primary",
        RequestStatus.InReview => "bg-info",
        RequestStatus.Assigned => "bg-warning text-dark",
        RequestStatus.Completed => "bg-success",
        RequestStatus.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetStatusButtonActive(RequestStatus status) => status switch
    {
        RequestStatus.Submitted => "btn-primary",
        RequestStatus.InReview => "btn-info",
        RequestStatus.Assigned => "btn-warning",
        RequestStatus.Completed => "btn-success",
        RequestStatus.Cancelled => "btn-secondary",
        _ => "btn-secondary"
    };

    private string GetStatusButtonOutline(RequestStatus status) => status switch
    {
        RequestStatus.Submitted => "btn-outline-primary",
        RequestStatus.InReview => "btn-outline-info",
        RequestStatus.Assigned => "btn-outline-warning",
        RequestStatus.Completed => "btn-outline-success",
        RequestStatus.Cancelled => "btn-outline-secondary",
        _ => "btn-outline-secondary"
    };

    private string GetRequestTypeLabel(EducationRequestType type) => type switch
    {
        EducationRequestType.HomeworkHelp => "Homework Help",
        EducationRequestType.PrintingAssistance => "Printing Assistance",
        EducationRequestType.EducationalSupport => "Educational Support",
        EducationRequestType.Other => "Other",
        _ => type.ToString()
    };
}
