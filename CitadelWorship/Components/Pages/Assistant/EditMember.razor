@page "/assistant/members/edit/{Id:int}"
@layout AssistantLayout
@attribute [Authorize(Roles = "AdminAssistant,Admin")]
@using Microsoft.AspNetCore.Identity
@inject IMemberProfileService MemberProfileService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "Add Member" : "Edit Member") - Citadel Worship Ministries</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi @(_isNew ? "bi-person-plus" : "bi-pencil-square")"></i>
            @(_isNew ? "Add New Member" : "Edit Member")
        </h2>
        <a href="/assistant/members" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Members
        </a>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading member data...</p>
        </div>
    }
    else if (_notFound)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Member profile not found.
            <a href="/assistant/members" class="alert-link">Return to members list</a>.
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-circle"></i> @_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="editMemberForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row g-3">
                        <!-- User Selection -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">User Account <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_model.UserId">
                                <option value="">-- Select User --</option>
                                @if (_users != null)
                                {
                                    @foreach (var user in _users)
                                    {
                                        <option value="@user.Id">@user.FullName (@user.Email)</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _model.UserId" class="text-danger" />
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone</label>
                            <InputText class="form-control" @bind-Value="_model.Phone" placeholder="e.g., +234 801 234 5678" />
                        </div>

                        <!-- Address -->
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Address</label>
                            <InputText class="form-control" @bind-Value="_model.Address" placeholder="Street address" />
                        </div>

                        <!-- City -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">City</label>
                            <InputText class="form-control" @bind-Value="_model.City" placeholder="City" />
                        </div>

                        <!-- State -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">State</label>
                            <InputText class="form-control" @bind-Value="_model.State" placeholder="State" />
                        </div>

                        <!-- Zip Code -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Zip Code</label>
                            <InputText class="form-control" @bind-Value="_model.ZipCode" placeholder="Zip code" />
                        </div>

                        <!-- Date of Birth -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Date of Birth</label>
                            <InputDate class="form-control" @bind-Value="_model.DateOfBirth" />
                        </div>

                        <!-- Gender -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Gender</label>
                            <InputSelect class="form-select" @bind-Value="_model.Gender">
                                <option value="">-- Select --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                        </div>

                        <!-- Membership Status -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Membership Status <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_model.MembershipStatus">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Visitor">Visitor</option>
                            </InputSelect>
                        </div>

                        <!-- Ministry Involvement -->
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Ministry Involvement</label>
                            <InputText class="form-control" @bind-Value="_model.MinistryInvolvement" placeholder="e.g., Choir, Ushering, Media" />
                        </div>

                        <!-- Emergency Contact Name -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Emergency Contact Name</label>
                            <InputText class="form-control" @bind-Value="_model.EmergencyContactName" placeholder="Full name" />
                        </div>

                        <!-- Emergency Contact Phone -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Emergency Contact Phone</label>
                            <InputText class="form-control" @bind-Value="_model.EmergencyContactPhone" placeholder="Phone number" />
                        </div>

                        <!-- Notes -->
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Notes</label>
                            <InputTextArea class="form-control" @bind-Value="_model.Notes" rows="3" placeholder="Any additional notes..." />
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/assistant/members" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle"></i>
                                <span>@(_isNew ? "Create Member" : "Save Changes")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private MemberProfile _model = new() { MembershipStatus = "Active" };
    private List<ApplicationUser>? _users;
    private bool _isNew => Id == 0;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _notFound = false;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users = UserManager.Users.OrderBy(u => u.LastName).ThenBy(u => u.FirstName).ToList();

            if (!_isNew)
            {
                var existing = await MemberProfileService.GetByIdAsync(Id);
                if (existing == null)
                {
                    _notFound = true;
                }
                else
                {
                    _model = existing;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_model.UserId))
        {
            _errorMessage = "Please select a user account.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (_isNew)
            {
                await MemberProfileService.CreateAsync(_model);
            }
            else
            {
                await MemberProfileService.UpdateAsync(_model);
            }

            Navigation.NavigateTo("/assistant/members");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error saving member: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
