@page "/admin/audit-logs"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IAuditService AuditService

<PageTitle>Audit Logs - Admin</PageTitle>

<h2 class="mb-4"><i class="bi bi-journal-text"></i> Audit Logs</h2>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">From</label>
                <input type="date" class="form-control" @bind="_startDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To</label>
                <input type="date" class="form-control" @bind="_endDate" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary" @onclick="ApplyFilter">Filter</button>
                <button class="btn btn-outline-secondary ms-1" @onclick="ClearFilter">Clear</button>
            </div>
        </div>
    </div>
</div>

@if (_logs == null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Timestamp</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Entity ID</th>
                        <th>User</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_logs.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">No audit logs found.</td></tr>
                    }
                    @foreach (var log in _logs)
                    {
                        <tr>
                            <td class="text-nowrap">@log.Timestamp.ToString("MMM d, yyyy HH:mm")</td>
                            <td><span class="badge @GetActionBadge(log.Action)">@log.Action</span></td>
                            <td>@log.EntityType</td>
                            <td><code>@log.EntityId</code></td>
                            <td>@log.UserName</td>
                            <td class="small">@log.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<AuditLog>? _logs;
    private DateTime? _startDate;
    private DateTime? _endDate;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _logs = _startDate.HasValue && _endDate.HasValue
            ? await AuditService.GetByDateRangeAsync(_startDate.Value, _endDate.Value.AddDays(1))
            : await AuditService.GetAllAsync(200);
    }

    private async Task ApplyFilter() => await LoadData();
    private async Task ClearFilter() { _startDate = null; _endDate = null; await LoadData(); }

    private string GetActionBadge(string action) => action switch
    {
        "Login" => "bg-info",
        "Create" => "bg-success",
        "Update" => "bg-warning text-dark",
        "Delete" => "bg-danger",
        "RoleChange" => "bg-purple bg-primary",
        _ => "bg-secondary"
    };
}
