@page "/admin/leaders"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject ILeaderService LeaderService

<PageTitle>Manage Leaders - Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people-fill"></i> Manage Leaders</h2>
    <a href="/admin/leaders/edit/0" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Leader
    </a>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

@if (_leaders == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">Loading leaders...</p>
    </div>
}
else if (!_leaders.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-people display-1 text-muted"></i>
            <h4 class="mt-3">No Leaders Added Yet</h4>
            <p class="text-muted">Add your church leaders to display them on the website.</p>
            <a href="/admin/leaders/edit/0" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add First Leader
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px;">Photo</th>
                        <th>Name</th>
                        <th>Title</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th style="width:150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leader in _leaders)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(leader.ImageUrl))
                                {
                                    <img src="@leader.ImageUrl" alt="@leader.FullName"
                                         class="rounded-circle" style="width:50px;height:50px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white"
                                         style="width:50px;height:50px;">
                                        <i class="bi bi-person"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">@leader.FullName</td>
                            <td>@leader.Title</td>
                            <td>
                                <span class="badge bg-secondary">@leader.DisplayOrder</span>
                            </td>
                            <td>
                                @if (leader.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/admin/leaders/edit/@leader.Id" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-outline-danger" title="Delete" @onclick="() => DeleteLeader(leader.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Leader>? _leaders;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaders();
    }

    private async Task LoadLeaders()
    {
        _leaders = await LeaderService.GetAllAsync();
    }

    private async Task DeleteLeader(int id)
    {
        var success = await LeaderService.DeleteAsync(id);
        if (success)
        {
            _message = "Leader deleted successfully.";
            _isError = false;
            await LoadLeaders();
        }
        else
        {
            _message = "Failed to delete leader.";
            _isError = true;
        }
    }
}
