@page "/admin/events"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IEventService EventService

<PageTitle>Manage Events - Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-event"></i> Manage Events</h2>
    <a href="/admin/events/edit/0" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Event
    </a>
</div>

@if (_events == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in _events)
                    {
                        <tr>
                            <td>
                                @evt.Title
                                @if (evt.IsMembersOnly)
                                {
                                    <span class="badge bg-info ms-1">Members</span>
                                }
                            </td>
                            <td>@evt.StartDate.ToString("MMM d, yyyy h:mm tt")</td>
                            <td>@evt.Location</td>
                            <td>@evt.Category</td>
                            <td>
                                @if (evt.IsPublished)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </td>
                            <td>
                                <a href="/admin/events/edit/@evt.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEvent(evt.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Event>? _events;

    protected override async Task OnInitializedAsync()
    {
        _events = await EventService.GetAllAsync();
    }

    private async Task DeleteEvent(int id)
    {
        await EventService.DeleteAsync(id);
        _events = await EventService.GetAllAsync();
    }
}
