@page "/admin/events/edit/{Id:int}"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IEventService EventService
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "Add" : "Edit") Event - Admin</PageTitle>

<h2>@(_isNew ? "Add New" : "Edit") Event</h2>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="_event" OnValidSubmit="HandleSubmit" FormName="EditEventForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_event.Title" />
                        <ValidationMessage For="() => _event.Title" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" @bind-Value="_event.Description" rows="4" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date & Time</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_event.StartDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">End Date & Time</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_event.EndDate" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Location</label>
                            <InputText class="form-control" @bind-Value="_event.Location" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Category</label>
                            <InputText class="form-control" @bind-Value="_event.Category" placeholder="e.g., Worship, Youth, Outreach" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contact Email</label>
                        <InputText class="form-control" @bind-Value="_event.ContactEmail" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Image URL</label>
                        <InputText class="form-control" @bind-Value="_event.ImageUrl" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_event.IsPublished" id="isPublished" />
                                <label class="form-check-label" for="isPublished">Published</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_event.IsMembersOnly" id="isMembersOnly" />
                                <label class="form-check-label" for="isMembersOnly">Members Only</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-check-lg"></i> Save Event
                        </button>
                        <a href="/admin/events" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Event _event = new() { StartDate = DateTime.UtcNow.AddDays(7), IsPublished = true };
    private bool _isNew => Id == 0;
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        if (!_isNew)
        {
            var existing = await EventService.GetByIdAsync(Id);
            if (existing != null)
            {
                _event = existing;
            }
            else
            {
                Navigation.NavigateTo("/admin/events");
            }
        }
    }

    private async Task HandleSubmit()
    {
        _saving = true;
        try
        {
            if (_isNew)
            {
                await EventService.CreateAsync(_event);
            }
            else
            {
                await EventService.UpdateAsync(_event);
            }
            Navigation.NavigateTo("/admin/events");
        }
        finally
        {
            _saving = false;
        }
    }
}
