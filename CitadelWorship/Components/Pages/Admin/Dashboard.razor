@page "/admin/dashboard"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject ISermonService SermonService
@inject IEventService EventService
@inject IMinistryService MinistryService
@inject IAnnouncementService AnnouncementService
@inject IPrayerRequestService PrayerRequestService
@inject IUserService UserService
@inject IFinancialService FinancialService
@inject IEducationRequestService EducationRequestService

<PageTitle>Admin Dashboard - Citadel Worship Ministries</PageTitle>

<h2 class="mb-4"><i class="bi bi-speedometer2"></i> Admin Dashboard</h2>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center bg-primary text-white">
            <div class="card-body py-3">
                <i class="bi bi-person-gear fs-4"></i>
                <h3 class="mt-1 mb-0">@_userCount</h3>
                <small>Users</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center bg-success text-white">
            <div class="card-body py-3">
                <i class="bi bi-cash-stack fs-4"></i>
                <h3 class="mt-1 mb-0">@_financialTotal.ToString("C")</h3>
                <small>Total Giving</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center bg-warning text-dark">
            <div class="card-body py-3">
                <i class="bi bi-mortarboard fs-4"></i>
                <h3 class="mt-1 mb-0">@_pendingEducation</h3>
                <small>Pending Edu Requests</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center bg-danger text-white">
            <div class="card-body py-3">
                <i class="bi bi-chat-heart fs-4"></i>
                <h3 class="mt-1 mb-0">@_prayerCount</h3>
                <small>Prayer Requests</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <i class="bi bi-book text-primary fs-4"></i>
                <h3 class="mt-1 mb-0">@_sermonCount</h3>
                <small class="text-muted">Sermons</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <i class="bi bi-calendar-event text-success fs-4"></i>
                <h3 class="mt-1 mb-0">@_eventCount</h3>
                <small class="text-muted">Events</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <i class="bi bi-people text-info fs-4"></i>
                <h3 class="mt-1 mb-0">@_ministryCount</h3>
                <small class="text-muted">Ministries</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <i class="bi bi-megaphone text-warning fs-4"></i>
                <h3 class="mt-1 mb-0">@_announcementCount</h3>
                <small class="text-muted">Announcements</small>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-12"><h4>Quick Actions</h4></div>
    <div class="col-md-2"><a href="/admin/sermons/edit/0" class="btn btn-outline-primary w-100 py-3"><i class="bi bi-plus-circle"></i><br/>New Sermon</a></div>
    <div class="col-md-2"><a href="/admin/events/edit/0" class="btn btn-outline-success w-100 py-3"><i class="bi bi-plus-circle"></i><br/>New Event</a></div>
    <div class="col-md-2"><a href="/admin/announcements/edit/0" class="btn btn-outline-warning w-100 py-3"><i class="bi bi-plus-circle"></i><br/>New Announcement</a></div>
    <div class="col-md-2"><a href="/admin/financials" class="btn btn-outline-info w-100 py-3"><i class="bi bi-cash-stack"></i><br/>Financials</a></div>
    <div class="col-md-2"><a href="/admin/audit-logs" class="btn btn-outline-dark w-100 py-3"><i class="bi bi-journal-text"></i><br/>Audit Logs</a></div>
    <div class="col-md-2"><a href="/admin/settings" class="btn btn-outline-secondary w-100 py-3"><i class="bi bi-gear"></i><br/>Settings</a></div>
</div>

<!-- Recent Prayer Requests -->
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-chat-heart"></i> Recent Prayer Requests</h5>
                <a href="/admin/prayer-requests" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                @if (_recentPrayers?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Submitted By</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prayer in _recentPrayers.Take(5))
                                {
                                    <tr>
                                        <td>@prayer.Title</td>
                                        <td>@(prayer.IsAnonymous ? "Anonymous" : prayer.SubmittedByUser?.FullName ?? "Unknown")</td>
                                        <td>@prayer.SubmittedAt.ToString("MMM d, yyyy")</td>
                                        <td><span class="badge @GetStatusBadge(prayer.Status)">@prayer.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No prayer requests yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int _sermonCount, _eventCount, _ministryCount, _announcementCount, _prayerCount, _userCount, _pendingEducation;
    private decimal _financialTotal;
    private List<PrayerRequest>? _recentPrayers;

    protected override async Task OnInitializedAsync()
    {
        var sermons = await SermonService.GetAllAsync();
        _sermonCount = sermons.Count;

        var events = await EventService.GetAllAsync();
        _eventCount = events.Count;

        var ministries = await MinistryService.GetAllAsync();
        _ministryCount = ministries.Count;

        var announcements = await AnnouncementService.GetAllAsync();
        _announcementCount = announcements.Count;

        _recentPrayers = await PrayerRequestService.GetAllAsync();
        _prayerCount = _recentPrayers.Count;

        var users = await UserService.GetAllUsersAsync();
        _userCount = users.Count;

        var summary = await FinancialService.GetSummaryAsync();
        _financialTotal = summary.GrandTotal;

        var eduRequests = await EducationRequestService.GetByStatusAsync(RequestStatus.Submitted);
        _pendingEducation = eduRequests.Count;
    }

    private string GetStatusBadge(PrayerRequestStatus status) => status switch
    {
        PrayerRequestStatus.New => "bg-primary",
        PrayerRequestStatus.Prayed => "bg-success",
        PrayerRequestStatus.Archived => "bg-secondary",
        _ => "bg-secondary"
    };
}
