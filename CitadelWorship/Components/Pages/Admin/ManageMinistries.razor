@page "/admin/ministries"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IMinistryService MinistryService

<PageTitle>Manage Ministries - Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people"></i> Manage Ministries</h2>
    <a href="/admin/ministries/edit/0" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Ministry
    </a>
</div>

@if (_ministries == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Leader</th>
                        <th>Schedule</th>
                        <th>Status</th>
                        <th>Order</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ministry in _ministries)
                    {
                        <tr>
                            <td>@ministry.Name</td>
                            <td>@ministry.LeaderName</td>
                            <td>@ministry.MeetingSchedule</td>
                            <td>
                                @if (ministry.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@ministry.SortOrder</td>
                            <td>
                                <a href="/admin/ministries/edit/@ministry.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMinistry(ministry.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Ministry>? _ministries;

    protected override async Task OnInitializedAsync()
    {
        _ministries = await MinistryService.GetAllAsync();
    }

    private async Task DeleteMinistry(int id)
    {
        await MinistryService.DeleteAsync(id);
        _ministries = await MinistryService.GetAllAsync();
    }
}
