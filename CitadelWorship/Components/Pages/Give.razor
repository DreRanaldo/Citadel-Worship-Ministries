@page "/give"

<PageTitle>Give - Citadel Worship Ministries</PageTitle>

<section class="page-header bg-dark text-white py-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Give</h1>
        <p class="lead">Your generosity makes a difference</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center mb-5">
                <p class="fs-5">
                    "Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion,
                    for God loves a cheerful giver."
                </p>
                <p class="text-muted fst-italic">— 2 Corinthians 9:7</p>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Online Giving -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm text-center">
                    <div class="card-body p-4">
                        <i class="bi bi-credit-card fs-1 text-primary"></i>
                        <h4 class="mt-3">Give Online</h4>
                        <p class="text-muted">Make a secure one-time or recurring donation through our online giving platform.</p>
                        <button class="btn btn-primary btn-lg" disabled>
                            <i class="bi bi-lock"></i> Give Now
                        </button>
                        <p class="text-muted small mt-2">(Online giving integration coming soon)</p>
                    </div>
                </div>
            </div>

            <!-- In-Person -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm text-center">
                    <div class="card-body p-4">
                        <i class="bi bi-building fs-1 text-primary"></i>
                        <h4 class="mt-3">Give In Person</h4>
                        <p class="text-muted">Offering baskets are available during all worship services. You can give by cash or check.</p>
                        <p class="fw-semibold">During any service</p>
                    </div>
                </div>
            </div>

            <!-- Mail -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm text-center">
                    <div class="card-body p-4">
                        <i class="bi bi-envelope fs-1 text-primary"></i>
                        <h4 class="mt-3">Give by Mail</h4>
                        <p class="text-muted">Send checks payable to "Citadel Worship Ministries" to our church address.</p>
                        <p class="fw-semibold">123 Faith Avenue<br />Springfield, IL 62701</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Impact Section -->
        <div class="row mt-5 pt-5 border-top">
            <div class="col-12 text-center mb-4">
                <h2>Your Giving Makes an Impact</h2>
                <p class="text-muted">Here's how your generous contributions are used</p>
            </div>
            <div class="col-md-3 col-6 text-center mb-4">
                <i class="bi bi-book fs-2 text-primary"></i>
                <h5 class="mt-2">Ministry Programs</h5>
                <p class="text-muted small">Supporting youth, children's, and outreach ministries</p>
            </div>
            <div class="col-md-3 col-6 text-center mb-4">
                <i class="bi bi-people fs-2 text-primary"></i>
                <h5 class="mt-2">Community Outreach</h5>
                <p class="text-muted small">Feeding the hungry and helping those in need</p>
            </div>
            <div class="col-md-3 col-6 text-center mb-4">
                <i class="bi bi-music-note-beamed fs-2 text-primary"></i>
                <h5 class="mt-2">Worship & Media</h5>
                <p class="text-muted small">Enhancing worship experience and online ministry</p>
            </div>
            <div class="col-md-3 col-6 text-center mb-4">
                <i class="bi bi-globe fs-2 text-primary"></i>
                <h5 class="mt-2">Missions</h5>
                <p class="text-muted small">Supporting missionaries and global outreach</p>
            </div>
        </div>
    </div>
</section>
