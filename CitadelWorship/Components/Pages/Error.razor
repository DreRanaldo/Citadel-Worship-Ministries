@page "/Error"
@using System.Diagnostics

<PageTitle>Error - Citadel Worship Ministries</PageTitle>

<div class="container py-5 text-center">
    <h1 class="display-4 text-danger"><i class="bi bi-exclamation-triangle"></i></h1>
    <h2>An error occurred</h2>
    <p class="text-muted">Sorry, something went wrong processing your request.</p>

    @if (ShowRequestId)
    {
        <p class="text-muted small">
            <strong>Request ID:</strong> <code>@RequestId</code>
        </p>
    }

    <a href="/" class="btn btn-primary mt-3">
        <i class="bi bi-house"></i> Return to Home
    </a>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
