@page "/events/{Id:int}"
@inject IEventService EventService
@inject NavigationManager Navigation

<PageTitle>@(_event?.Title ?? "Event") - Citadel Worship Ministries</PageTitle>

@if (_event == null)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <section class="page-header bg-dark text-white py-5">
        <div class="container text-center">
            <h1 class="display-5 fw-bold">@_event.Title</h1>
            <p class="lead">@_event.StartDate.ToString("dddd, MMMM d, yyyy")</p>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h3>Event Details</h3>
                            <p class="fs-5">@_event.Description</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h5>Information</h5>
                            <hr />
                            <p>
                                <i class="bi bi-calendar text-primary"></i>
                                <strong>Date:</strong> @_event.StartDate.ToString("MMMM d, yyyy")
                            </p>
                            <p>
                                <i class="bi bi-clock text-primary"></i>
                                <strong>Time:</strong> @_event.StartDate.ToString("h:mm tt")
                                @if (_event.EndDate.HasValue)
                                {
                                    <text> - @_event.EndDate.Value.ToString("h:mm tt")</text>
                                }
                            </p>
                            @if (!string.IsNullOrEmpty(_event.Location))
                            {
                                <p>
                                    <i class="bi bi-geo-alt text-primary"></i>
                                    <strong>Location:</strong> @_event.Location
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(_event.Category))
                            {
                                <p>
                                    <i class="bi bi-tag text-primary"></i>
                                    <strong>Category:</strong> @_event.Category
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(_event.ContactEmail))
                            {
                                <p>
                                    <i class="bi bi-envelope text-primary"></i>
                                    <strong>Contact:</strong> @_event.ContactEmail
                                </p>
                            }
                            @if (_event.IsMembersOnly)
                            {
                                <div class="alert alert-info mt-3">
                                    <i class="bi bi-info-circle"></i> This event is for church members only.
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="/events" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Events
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    private Event? _event;

    protected override async Task OnInitializedAsync()
    {
        _event = await EventService.GetByIdAsync(Id);
        if (_event == null)
        {
            Navigation.NavigateTo("/events");
        }
    }
}
