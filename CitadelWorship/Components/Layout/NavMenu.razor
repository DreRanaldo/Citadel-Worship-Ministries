@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
        <AuthorizeView>
            <Authorized>
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-building"></i> Citadel Worship
                </a>
            </Authorized>
            <NotAuthorized>
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-building"></i> Citadel Worship
                </a>
            </NotAuthorized>
        </AuthorizeView>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <AuthorizeView>
                <NotAuthorized>
                    @* ===== PUBLIC NAVIGATION (Guest/Anonymous) ===== *@
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="/leaders">Leaders</a></li>
                        <li class="nav-item"><a class="nav-link" href="/ministries">Ministries</a></li>
                        <li class="nav-item"><a class="nav-link" href="/events">Events</a></li>
                        <li class="nav-item"><a class="nav-link" href="/sermons">Sermons</a></li>
                        <li class="nav-item"><a class="nav-link" href="/gallery">Gallery</a></li>
                        <li class="nav-item"><a class="nav-link" href="/give">Give</a></li>
                        <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/account/login"><i class="bi bi-box-arrow-in-right"></i> Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm ms-2 mt-1" href="/account/register">Register</a>
                        </li>
                    </ul>
                </NotAuthorized>
                <Authorized>
                    @* ===== AUTHENTICATED NAVIGATION (Role-based) ===== *@
                    <ul class="navbar-nav me-auto">
                        @* ----- Admin Navigation ----- *@
                        <AuthorizeView Roles="Admin" Context="adminNav">
                            <Authorized>
                                <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Content</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="/admin/sermons">Sermons</a></li>
                                        <li><a class="dropdown-item" href="/admin/events">Events</a></li>
                                        <li><a class="dropdown-item" href="/admin/ministries">Ministries</a></li>
                                        <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/admin/leaders">Leaders</a></li>
                                        <li><a class="dropdown-item" href="/admin/gallery">Gallery</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Management</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="/admin/users">Users & Roles</a></li>
                                        <li><a class="dropdown-item" href="/admin/prayer-requests">Prayer Requests</a></li>
                                        <li><a class="dropdown-item" href="/admin/education-requests">Education Requests</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/admin/financials">Financial Overview</a></li>
                                        <li><a class="dropdown-item" href="/admin/audit-logs">Audit Logs</a></li>
                                        <li><a class="dropdown-item" href="/admin/settings">Site Settings</a></li>
                                    </ul>
                                </li>
                            </Authorized>
                        </AuthorizeView>

                        @* ----- Admin Assistant Navigation ----- *@
                        <AuthorizeView Roles="AdminAssistant" Context="assistantNav">
                            <Authorized>
                                <li class="nav-item"><a class="nav-link" href="/assistant/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" href="/assistant/members">Members</a></li>
                                <li class="nav-item"><a class="nav-link" href="/assistant/attendance">Attendance</a></li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Finances</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="/assistant/finances/log">Log Entry</a></li>
                                        <li><a class="dropdown-item" href="/assistant/finances">View Records</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item"><a class="nav-link" href="/assistant/education-requests">Education</a></li>
                                <li class="nav-item"><a class="nav-link" href="/assistant/notes">Notes</a></li>
                                <li class="nav-item"><a class="nav-link" href="/gallery">Gallery</a></li>
                            </Authorized>
                        </AuthorizeView>

                        @* ----- Member Navigation (only if not Admin or AdminAssistant) ----- *@
                        <AuthorizeView Roles="Member" Context="memberNav">
                            <Authorized>
                                @if (!(_isAdmin || _isAssistant))
                                {
                                    <li class="nav-item"><a class="nav-link" href="/member/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/member/announcements">Announcements</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/member/events">Events</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/member/prayer-requests">Prayer Requests</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/member/education-requests">Education Help</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/gallery">Gallery</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/leaders">Leaders</a></li>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </ul>

                    @* ----- User dropdown (all authenticated users) ----- *@
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i> @context.User.Identity?.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/account/profile"><i class="bi bi-person"></i> Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/account/logout"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
                            </ul>
                        </li>
                    </ul>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private bool _isAdmin;
    private bool _isAssistant;

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User?.Identity?.IsAuthenticated == true)
        {
            var user = await UserManager.GetUserAsync(httpContext.User);
            if (user != null)
            {
                _isAdmin = await UserManager.IsInRoleAsync(user, "Admin");
                _isAssistant = await UserManager.IsInRoleAsync(user, "AdminAssistant");
            }
        }
    }
}
