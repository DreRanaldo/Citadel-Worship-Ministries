@inherits LayoutComponentBase
@attribute [Authorize(Roles = "Admin")]

<div class="admin-wrapper">
    <NavMenu />

    <div class="container-fluid">
        <div class="row">
            <!-- Admin Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse" id="adminSidebar">
                <div class="position-sticky pt-3">
                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-2 mb-1 text-muted text-uppercase">
                        <span>Admin Panel</span>
                    </h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/dashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                    </ul>

                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                        <span>Content</span>
                    </h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/sermons">
                                <i class="bi bi-book"></i> Sermons
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/events">
                                <i class="bi bi-calendar-event"></i> Events
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/ministries">
                                <i class="bi bi-people"></i> Ministries
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/announcements">
                                <i class="bi bi-megaphone"></i> Announcements
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/leaders">
                                <i class="bi bi-person-badge"></i> Leaders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/gallery">
                                <i class="bi bi-images"></i> Gallery
                            </a>
                        </li>
                    </ul>

                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                        <span>Management</span>
                    </h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/users">
                                <i class="bi bi-person-gear"></i> Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/financials">
                                <i class="bi bi-currency-dollar"></i> Financials
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/education-requests">
                                <i class="bi bi-mortarboard"></i> Education Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/audit-logs">
                                <i class="bi bi-journal-text"></i> Audit Logs
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/prayer-requests">
                                <i class="bi bi-chat-heart"></i> Prayer Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/admin/settings">
                                <i class="bi bi-gear"></i> Site Settings
                            </a>
                        </li>
                    </ul>

                    <hr class="text-muted" />
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/">
                                <i class="bi bi-arrow-left"></i> Back to Site
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @Body
            </main>
        </div>
    </div>
</div>
