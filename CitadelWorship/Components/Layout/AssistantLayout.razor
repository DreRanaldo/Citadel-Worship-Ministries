@inherits LayoutComponentBase
@attribute [Authorize(Roles = "Admin,AdminAssistant")]

<div class="assistant-wrapper">
    <NavMenu />

    <div class="container-fluid">
        <div class="row">
            <!-- Assistant Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse" id="assistantSidebar">
                <div class="position-sticky pt-3">
                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-2 mb-1 text-muted text-uppercase">
                        <span>Assistant Panel</span>
                    </h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/assistant/dashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                    </ul>

                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                        <span>Members</span>
                    </h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/assistant/members">
                                <i class="bi bi-people"></i> Member Registry
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/assistant/attendance">
                                <i class="bi bi-calendar-check"></i> Attendance
                            </a>
                        </li>
                    </ul>

                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                        <span>Financial</span>
                    </h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/assistant/finances">
                                <i class="bi bi-cash-stack"></i> View Records
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/assistant/finances/log">
                                <i class="bi bi-plus-circle"></i> Log Entry
                            </a>
                        </li>
                    </ul>

                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                        <span>Support</span>
                    </h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/assistant/education-requests">
                                <i class="bi bi-mortarboard"></i> Education Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/assistant/notes">
                                <i class="bi bi-journal-text"></i> Special Notes
                            </a>
                        </li>
                    </ul>

                    <hr class="text-muted" />
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/">
                                <i class="bi bi-arrow-left"></i> Back to Site
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @Body
            </main>
        </div>
    </div>
</div>
